    "companionBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BÜHNE and STRÖM work as a pair: STRÖM downloads, BÜHNE plays. BÜHNE is free and has no paid Plus version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BÜHNE und STRÖM arbeiten als Paar: STRÖM lädt herunter, BÜHNE spielt ab. BÜHNE ist kostenlos und hat keine kostenpflichtige Plus-Version."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BÜHNE et STRÖM forment un duo : STRÖM télécharge, BÜHNE lit. BÜHNE est gratuit et n’a pas de version Plus payante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BÜHNE e STRÖM lavorano in coppia: STRÖM scarica, BÜHNE riproduce. BÜHNE è gratuito e non ha una versione Plus a pagamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "BÜHNE и STRÖM работают в паре: STRÖM скачивает, BÜHNE проигрывает. BÜHNE бесплатен и не имеет платной версии Plus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BÜHNE y STRÖM funcionan en pareja: STRÖM descarga, BÜHNE reproduce. BÜHNE es gratuito y no tiene versión Plus de pago."
          }
        }
      }
    },
